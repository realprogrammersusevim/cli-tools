#!/usr/bin/env python3
from __future__ import annotations

import argparse
import os
import shutil
import sqlite3
import subprocess
import sys
import tempfile
import webbrowser
from pathlib import Path
from typing import Optional


DEFAULT_TABLE = "responses"
DEFAULT_COLUMN = "response"


def resolve_db_path(db: Optional[str]) -> Optional[Path]:
    """Return the best guess for logs.db, or None if not found."""
    if db:
        return Path(db).expanduser()

    candidates = []

    xdg = os.environ.get("XDG_DATA_HOME")
    if xdg:
        candidates.append(Path(xdg) / "llm" / "logs.db")

    candidates.extend(
        [
            Path.home() / ".local" / "share" / "llm" / "logs.db",
            Path.home()
            / "Library"
            / "Application Support"
            / "io.datasette.llm"
            / "logs.db",
        ]
    )

    return next((p for p in candidates if p.is_file()), None)


def fetch_last_response(db_path: Path, n: int) -> str:
    """Fetch the Nth most recent response (n=1 is latest)."""
    if n < 1:
        raise ValueError("--n must be >= 1")

    offset = n - 1
    query = (
        f"SELECT {DEFAULT_COLUMN} "
        f"FROM {DEFAULT_TABLE} "
        "ORDER BY rowid DESC "
        "LIMIT 1 OFFSET ?"
    )

    with sqlite3.connect(db_path) as con:
        row = con.execute(query, (offset,)).fetchone()

    return "" if not row or row[0] is None else str(row[0])


def read_input(last: bool, n: int, db_arg: Optional[str]) -> str:
    if last:
        db_path = resolve_db_path(db_arg)
        if not db_path:
            raise SystemExit(
                "Could not find logs.db. Pass --db PATH or set LLM_LOGS_DB."
            )
        if not db_path.is_file():
            raise SystemExit(f"DB not found: {db_path}")

        return fetch_last_response(db_path, n)

    if sys.stdin.isatty():
        raise SystemExit("No input on stdin. Pipe markdown in, or use --last.")

    return sys.stdin.read()


def require_pandoc() -> str:
    exe = shutil.which("pandoc")
    if not exe:
        raise SystemExit("pandoc is required (not found on PATH).")
    return exe


def render_markdown_to_html(markdown: str) -> Path:
    pandoc = require_pandoc()

    css_header = """<style>
  body { max-width: 920px; margin: 2rem auto; padding: 0 1rem;
         font: 16px/1.5 system-ui, -apple-system, Segoe UI, Roboto, sans-serif; }
  code, pre { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas,
              "Liberation Mono", monospace; }
  pre { padding: 12px; overflow: auto; background: #f6f8fa; border-radius: 8px; }
</style>
"""

    # Don't use TemporaryDirectory() because browsers may load the file after we exit.
    out_html = Path(tempfile.mkstemp(prefix="llm-output-", suffix=".html")[1])
    with tempfile.TemporaryDirectory() as tmpdir:
        tmpdir = Path(tmpdir)
        md = tmpdir / "in.md"
        header = tmpdir / "header.html"

        md.write_text(markdown, encoding="utf-8")
        header.write_text(css_header, encoding="utf-8")

        subprocess.run(
            [
                pandoc,
                str(md),
                "-f",
                "markdown+tex_math_dollars+tex_math_double_backslash+tex_math_single_backslash",
                "-t",
                "html5",
                "-s",
                "--mathml",
                "-V",
                "title=LLM Output",
                "-H",
                str(header),
                "-o",
                str(out_html),
            ],
            check=True,
        )

    return out_html


def open_in_browser(path: Path) -> None:
    if not webbrowser.open(path.as_uri(), new=2):
        print(path)


def open_in_quicklook(path: Path) -> bool:
    if sys.platform != "darwin":
        return False
    qlmanage = shutil.which("qlmanage")
    if not qlmanage:
        return False
    try:
        subprocess.Popen(
            [qlmanage, "-p", str(path)],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except OSError:
        return False
    return True


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        description=("Render markdown to HTML and open it (Quick Look on macOS).")
    )
    p.add_argument("-l", "--last", action="store_true", help="Use last LLM response")
    p.add_argument(
        "-n", type=int, default=1, help="Nth most recent response (1=latest)"
    )
    p.add_argument(
        "--db", default=os.environ.get("LLM_LOGS_DB"), help="Path to logs.db"
    )
    p.add_argument(
        "--print-db",
        action="store_true",
        help="Print the resolved DB path and exit (0 if found, 1 otherwise)",
    )
    p.add_argument(
        "--browser",
        action="store_true",
        help="Force opening in the default browser",
    )
    return p


def main(argv: Optional[list[str]] = None) -> int:
    args = build_parser().parse_args(argv)

    if args.print_db:
        db_path = resolve_db_path(args.db)
        if db_path:
            print(db_path)
            return 0
        return 1

    content = read_input(args.last, args.n, args.db)
    html_path = render_markdown_to_html(content)
    if not args.browser and sys.platform == "darwin":
        if open_in_quicklook(html_path):
            return 0
    open_in_browser(html_path)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
